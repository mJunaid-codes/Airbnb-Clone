<%- include('../partials/head') %>

<body class="bg-gray-50">
  <%- include('../partials/nav') %>

  <main class="container mx-auto max-w-6xl px-4 py-10">

    <!-- TITLE -->
    <h2 class="text-3xl font-bold text-gray-900 text-center mb-10">
      Details of <%= home.houseName %>
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 bg-white p-6 rounded-xl shadow-sm">

      <!-- IMAGE -->
      <div class="rounded-xl overflow-hidden">
        <img src="<%= home.photoUrl %>"
             alt="<%= home.houseName %>"
             class="w-full h-[420px] object-cover hover:scale-105 transition duration-300">
      </div>

      <!-- DETAILS -->
      <div class="flex flex-col justify-between space-y-6">

        <!-- DESCRIPTION -->
        <div>
          <h3 class="text-xl font-semibold text-gray-900 mb-2">Description</h3>
          <p class="text-gray-600 leading-relaxed">
            <%= home.description %>
          </p>
        </div>

        <!-- LOCATION -->
        <div>
          <h3 class="text-xl font-semibold text-gray-900 mb-2">Location</h3>
          <p class="text-gray-900">
            <%= home.location %>
          </p>
        </div>

        <!-- PRICE -->
        <div>
          <h3 class="text-xl font-semibold text-gray-900 mb-2">Price</h3>
          <p class="text-rose-500 text-2xl font-bold">
            Rs - <%= home.price %> / Night
          </p>
        </div>

        <!-- RATING -->
        <div>
          <h3 class="text-xl font-semibold text-gray-900 mb-2">Rating</h3>
          <div class="flex items-center gap-2">
            <span class="text-yellow-500 text-lg">★</span>
            <span class="text-gray-700 text-lg">
              <%= home.rating %> / 5
            </span>
          </div>
        </div>

        <!-- ACTIONS -->
        <div class="pt-4 flex gap-3 items-center">
          <%- include('../partials/favourite', { home: home }) %>
        </div>

      </div>
    </div>

  </main>
</body>
</html>